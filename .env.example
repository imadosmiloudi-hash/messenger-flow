# App
APP_NAME=Messenger Flow Operator
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin bootstrap (created on first startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Database (SQLite default for local; Postgres in docker-compose)
DATABASE_URL=sqlite:///./data/app.db

# Redis / RQ
REDIS_URL=redis://localhost:6379/0

# Meta Graph API
META_GRAPH_API_VERSION=v26.0
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_webhook_verify_token
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=

# Public URL (ngrok or production HTTPS) used in webhook docs / media
PUBLIC_BASE_URL=https://your-ngrok-or-domain.example

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limits
LOGIN_RATE_LIMIT=10/minute
SEND_RATE_LIMIT=30/minute

# Media
MEDIA_UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
